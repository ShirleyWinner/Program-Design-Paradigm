        <mxCell id="48" value="Notation: - private  |  + public  |  hollow triangle = inheritance  |  solid line = association  |  filled diamond = composition" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Helvetica;fontSize=13;fontColor=#243448;strokeColor=none;fillColor=none;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="50" y="1220" width="985.1199999999999" height="22" as="geometry" />
        </mxCell>
        <mxCell id="49" value="Dashed arrow = dependency. Constructor (...) abbreviates parameters. Inherited members are not repeated." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Helvetica;fontSize=13;fontColor=#243448;strokeColor=none;fillColor=none;fontStyle=0;" parent="1" vertex="1">
