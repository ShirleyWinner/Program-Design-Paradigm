        <mxCell id="48" value="Notation: - private  |  + public  |  hollow triangle = inheritance  |  solid line = association  |  filled diamond = composition" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Helvetica;fontSize=13;fontColor=#243448;strokeColor=none;fillColor=none;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="50" y="1140" width="985.1199999999999" height="22" as="geometry" />
        </mxCell>
        <mxCell id="49" value="Dashed arrow = dependency. Constructor (...) abbreviates parameters. Inherited members are not repeated." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Helvetica;fontSize=13;fontColor=#243448;strokeColor=none;fillColor=none;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="50" y="1163" width="804.16" height="22" as="geometry" />
        </mxCell>
        <mxCell id="50" value="DESIGN RATIONALE / OPEN QUESTION" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Helvetica;fontSize=13;fontColor=#243448;strokeColor=none;fillColor=none;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="50" y="1192" width="261.28" height="22" as="geometry" />
        </mxCell>
        <mxCell id="51" value="Inheritance puts shared item data in CatalogItem and category-specific data in the concrete subclasses." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Helvetica;fontSize=13;fontColor=#243448;strokeColor=none;fillColor=none;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="50" y="1217" width="796.6199999999999" height="22" as="geometry" />
        </mxCell>
        <mxCell id="52" value="BrandModel is associated with catalog items because a brand/model value can describe multiple items without exclusive ownership." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Helvetica;fontSize=13;fontColor=#243448;strokeColor=none;fillColor=none;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="50" y="1239" width="985.1199999999999" height="22" as="geometry" />
        </mxCell>
        <mxCell id="53" value="Furniture is the least certain abstraction because Sofa is its only current subtype, although the statement explicitly identifies that category." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Helvetica;fontSize=13;fontColor=#243448;strokeColor=none;fillColor=none;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="50" y="1261" width="1105.76" height="22" as="geometry" />
        </mxCell>
        <mxCell id="54" value="An open question is whether an ID identifies one physical unit or a catalog listing containing multiple matching units." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Helvetica;fontSize=13;fontColor=#243448;strokeColor=none;fillColor=none;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="50" y="1283" width="917.26" height="22" as="geometry" />
        </mxCell>
      </root>
