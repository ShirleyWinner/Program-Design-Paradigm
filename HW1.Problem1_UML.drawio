          <mxGeometry x="50" y="1272" width="261.28" height="22" as="geometry" />
        </mxCell>
        <mxCell id="51" value="A member composes one PointsBalance because that mutable balance belongs exclusively to that account; Name values can be shared." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Helvetica;fontSize=13;fontColor=#243448;strokeColor=none;fillColor=none;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="50" y="1297" width="985.1199999999999" height="22" as="geometry" />
        </mxCell>
        <mxCell id="52" value="Deposit is a transfer request, so transferPoints depends on it rather than storing it as a permanent part of a member." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Helvetica;fontSize=13;fontColor=#243448;strokeColor=none;fillColor=none;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="50" y="1319" width="909.7199999999999" height="22" as="geometry" />
        </mxCell>
        <mxCell id="53" value="MemberDirectory is the least certain class: it is an added lookup abstraction needed to validate existing recipient IDs and names." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Helvetica;fontSize=13;fontColor=#243448;strokeColor=none;fillColor=none;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="50" y="1341" width="1000.1999999999999" height="22" as="geometry" />
        </mxCell>
        <mxCell id="54" value="The open question is how a transfer affects the sender's earned/expiring counters; only recipient counter updates are specified." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Helvetica;fontSize=13;fontColor=#243448;strokeColor=none;fillColor=none;fontStyle=0;" parent="1" vertex="1">
