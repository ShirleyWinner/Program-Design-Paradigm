        <mxCell id="56" value="HouseholdMember inherits common member data and adds only the four household fields, avoiding irrelevant fields on FarmerMember." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Helvetica;fontSize=13;fontColor=#243448;strokeColor=none;fillColor=none;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="50" y="1377" width="985.1199999999999" height="22" as="geometry" />
        </mxCell>
        <mxCell id="57" value="ContactInfo and Name use associations because the statement does not specify exclusive ownership or object lifetime." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Helvetica;fontSize=13;fontColor=#243448;strokeColor=none;fillColor=none;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="50" y="1399" width="894.64" height="22" as="geometry" />
        </mxCell>
        <mxCell id="58" value="IndividualMember is the least certain abstraction because it currently has one concrete subtype and no additional fields." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Helvetica;fontSize=13;fontColor=#243448;strokeColor=none;fillColor=none;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="50" y="1421" width="932.3399999999999" height="22" as="geometry" />
        </mxCell>
        <mxCell id="59" value="The open question is how each membership type calculates dues; no calculation method or enum is invented without those rules." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Helvetica;fontSize=13;fontColor=#243448;strokeColor=none;fillColor=none;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="50" y="1443" width="962.4999999999999" height="22" as="geometry" />
